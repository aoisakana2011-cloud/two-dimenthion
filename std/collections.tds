fn index_of_str(items: list[str], target: str) -> int {
  int index = 0
  int result = -1
  bool searching = true
  for item in items {
    if searching and item == target {
      set result = index
      set searching = false
    }
    set index = index + 1
  }
  return result
}

fn append_unique_str(items: list[str], item: str) -> list[str] {
  if list.contains(items, item) {
    return items
  }
  return list.append(items, item)
}

fn remove_all_str(items: list[str], item: str) -> list[str] {
  list[str] result = []
  for current in items {
    if current != item {
      set result = list.append(result, current)
    }
  }
  return result
}
