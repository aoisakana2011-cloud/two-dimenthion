fn index_of_str(items: list[str], target: str) -> int {
  int index = 0
  for item in items {
    if item == target {
      return index
    }
    set index = index + 1
  }
  return -1
}

fn append_unique_str(items: list[str], item: str) -> list[str] {
  if list.contains(items, item) {
    return items
  }
  return list.append(items, item)
}

fn remove_all_str(items: list[str], item: str) -> list[str] {
  return list.remove_all(items, item)
}
