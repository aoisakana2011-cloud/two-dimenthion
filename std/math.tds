# Float math helpers shared by Browser and Native builds.
# Angles are radians. Trigonometric functions delegate to the shared numeric intrinsics.

fn pi() -> float {
  return 3.141592653589793
}

fn tau() -> float {
  return 6.283185307179586
}

fn radians(degrees: float) -> float {
  return degrees * 0.017453292519943295
}

fn degrees(radians: float) -> float {
  return radians * 57.29577951308232
}

fn abs(value: float) -> float {
  if value < 0.0 {
    return 0.0 - value
  }
  return value
}

fn min(a: float, b: float) -> float {
  if a < b {
    return a
  }
  return b
}

fn max(a: float, b: float) -> float {
  if a > b {
    return a
  }
  return b
}

fn sign(value: float) -> float {
  if value < 0.0 {
    return 0.0 - 1.0
  }
  if value > 0.0 {
    return 1.0
  }
  return 0.0
}

fn sqrt(value: float) -> float {
  if value <= 0.0 {
    return 0.0
  }
  # Scale by powers of four first so Newton iteration converges quickly for
  # both small and large values without overflowing an initial guess.
  float scaled = value
  float scale = 1.0
  while scaled >= 4.0 {
    set scaled = scaled / 4.0
    set scale = scale * 2.0
  }
  while scaled < 1.0 {
    set scaled = scaled * 4.0
    set scale = scale / 2.0
  }

  float guess = 1.5
  int iteration = 0
  while iteration < 8 {
    set guess = (guess + scaled / guess) / 2.0
    set iteration = iteration + 1
  }
  return guess * scale
}

fn floor(value: float) -> float {
  # Beyond 2^52 every finite double is already an integer; avoid the narrower
  # signed-64-bit int conversion at the edges of the float range.
  if value <= 0.0 - 4503599627370496.0 or value >= 4503599627370496.0 {
    return value
  }
  float whole = float(int(value))
  if value < whole {
    return whole - 1.0
  }
  return whole
}

fn ceil(value: float) -> float {
  if value <= 0.0 - 4503599627370496.0 or value >= 4503599627370496.0 {
    return value
  }
  float whole = float(int(value))
  if value > whole {
    return whole + 1.0
  }
  return whole
}

fn round(value: float) -> float {
  if value <= 0.0 - 4503599627370496.0 or value >= 4503599627370496.0 {
    return value
  }
  if value < 0.0 {
    return 0.0 - floor(0.0 - value + 0.5)
  }
  return floor(value + 0.5)
}

fn clamp(value: float, lower: float, upper: float) -> float {
  float minimum = lower
  float maximum = upper
  if minimum > maximum {
    set minimum = upper
    set maximum = lower
  }
  if value < minimum {
    return minimum
  }
  if value > maximum {
    return maximum
  }
  return value
}

fn lerp(a: float, b: float, amount: float) -> float {
  # Weighted interpolation avoids overflowing b - a for opposite-sign endpoints.
  # Keep using it for extrapolation too: the direct difference can overflow even
  # when the extrapolated result itself is still representable.
  if a < 0.0 and b > 0.0 or a > 0.0 and b < 0.0 {
    return a * (1.0 - amount) + b * amount
  }
  return a + (b - a) * amount
}

fn map_range(value: float, input_min: float, input_max: float, output_min: float, output_max: float) -> float {
  if input_min == input_max {
    return output_min
  }
  if input_min < 0.0 and input_max > 0.0 or input_min > 0.0 and input_max < 0.0 {
    float scale = max(abs(value), max(abs(input_min), abs(input_max)))
    return lerp(output_min, output_max, (value / scale - input_min / scale) / (input_max / scale - input_min / scale))
  }
  if value < 0.0 and input_min >= 0.0 and input_max >= 0.0 or value > 0.0 and input_min <= 0.0 and input_max <= 0.0 {
    float value_scale = max(abs(value), max(abs(input_min), abs(input_max)))
    return lerp(output_min, output_max, (value / value_scale - input_min / value_scale) / (input_max / value_scale - input_min / value_scale))
  }
  return lerp(output_min, output_max, (value - input_min) / (input_max - input_min))
}

fn distance(x1: float, y1: float, x2: float, y2: float) -> float {
  # Scale coordinates before subtraction so the delta itself cannot overflow.
  float scale = max(abs(x1), max(abs(y1), max(abs(x2), abs(y2))))
  if scale == 0.0 {
    return 0.0
  }
  float scaled_x = x2 / scale - x1 / scale
  float scaled_y = y2 / scale - y1 / scale
  float magnitude = sqrt(scaled_x * scaled_x + scaled_y * scaled_y)
  float maximum = 1.7976931348623157e308
  if magnitude > 1.0 and scale > maximum / magnitude {
    return maximum
  }
  return scale * magnitude
}

fn approach(current: float, target: float, max_delta: float) -> float {
  float change = abs(max_delta)
  if current < target {
    if current >= 0.0 and target - current <= change {
      return target
    }
    return min(current + change, target)
  }
  if current > target {
    # Only form the distance when both values are non-positive. Across zero,
    # current - target can overflow even though both endpoints are finite.
    if target <= 0.0 and current <= 0.0 and current - target <= change {
      return target
    }
    return max(current - change, target)
  }
  return target
}

fn smoothstep(edge0: float, edge1: float, value: float) -> float {
  if edge0 == edge1 {
    if value < edge0 {
      return 0.0
    }
    return 1.0
  }
  if edge0 < edge1 {
    if value <= edge0 { return 0.0 }
    if value >= edge1 { return 1.0 }
  } else {
    if value <= edge1 { return 1.0 }
    if value >= edge0 { return 0.0 }
  }
  float t = 0.0
  if edge0 < 0.0 and edge1 > 0.0 or edge0 > 0.0 and edge1 < 0.0 {
    float scale = max(abs(edge0), abs(edge1))
    set t = (value / scale - edge0 / scale) / (edge1 / scale - edge0 / scale)
  } else {
    set t = (value - edge0) / (edge1 - edge0)
  }
  set t = clamp(t, 0.0, 1.0)
  return t * t * (3.0 - 2.0 * t)
}

fn smootherstep(edge0: float, edge1: float, value: float) -> float {
  if edge0 == edge1 {
    if value < edge0 {
      return 0.0
    }
    return 1.0
  }
  if edge0 < edge1 {
    if value <= edge0 { return 0.0 }
    if value >= edge1 { return 1.0 }
  } else {
    if value <= edge1 { return 1.0 }
    if value >= edge0 { return 0.0 }
  }
  float t = 0.0
  if edge0 < 0.0 and edge1 > 0.0 or edge0 > 0.0 and edge1 < 0.0 {
    float scale = max(abs(edge0), abs(edge1))
    set t = (value / scale - edge0 / scale) / (edge1 / scale - edge0 / scale)
  } else {
    set t = (value - edge0) / (edge1 - edge0)
  }
  set t = clamp(t, 0.0, 1.0)
  return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
}

fn ease_in_quad(amount: float) -> float {
  float t = clamp(amount, 0.0, 1.0)
  return t * t
}

fn ease_out_quad(amount: float) -> float {
  float t = clamp(amount, 0.0, 1.0)
  return t * (2.0 - t)
}

fn ease_in_out_quad(amount: float) -> float {
  float t = clamp(amount, 0.0, 1.0)
  if t < 0.5 {
    return 2.0 * t * t
  }
  return 0.0 - 1.0 + (4.0 - 2.0 * t) * t
}

fn ease_in_cubic(amount: float) -> float {
  float t = clamp(amount, 0.0, 1.0)
  return t * t * t
}

fn ease_out_cubic(amount: float) -> float {
  float t = clamp(amount, 0.0, 1.0) - 1.0
  return t * t * t + 1.0
}

fn ease_in_out_cubic(amount: float) -> float {
  float t = clamp(amount, 0.0, 1.0)
  if t < 0.5 {
    return 4.0 * t * t * t
  }
  float shifted = 2.0 * t - 2.0
  return 0.5 * shifted * shifted * shifted + 1.0
}

fn sin(angle: float) -> float {
  if angle != angle or angle > 1.7976931348623157e308 or angle < 0.0 - 1.7976931348623157e308 {
    return 0.0
  }
  return __intrinsic_sin(angle)
}

fn cos(angle: float) -> float {
  if angle != angle or angle > 1.7976931348623157e308 or angle < 0.0 - 1.7976931348623157e308 {
    return 0.0
  }
  return __intrinsic_cos(angle)
}
