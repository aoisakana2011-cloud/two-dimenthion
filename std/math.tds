# Float math helpers shared by Browser and Native builds.
# Angles are radians. Trigonometric functions use a range-reduced Taylor series.

fn pi() -> float {
  return 3.141592653589793
}

fn tau() -> float {
  return 6.283185307179586
}

fn radians(degrees: float) -> float {
  return degrees * 0.017453292519943295
}

fn degrees(radians: float) -> float {
  return radians * 57.29577951308232
}

fn abs(value: float) -> float {
  if value < 0.0 {
    return 0.0 - value
  }
  return value
}

fn min(a: float, b: float) -> float {
  if a < b {
    return a
  }
  return b
}

fn max(a: float, b: float) -> float {
  if a > b {
    return a
  }
  return b
}

fn sign(value: float) -> float {
  if value < 0.0 {
    return 0.0 - 1.0
  }
  if value > 0.0 {
    return 1.0
  }
  return 0.0
}

fn sqrt(value: float) -> float {
  if value <= 0.0 {
    return 0.0
  }

  # Scale by powers of four first so Newton iteration converges quickly for
  # both small and large values without overflowing an initial guess.
  float scaled = value
  float scale = 1.0
  while scaled >= 4.0 {
    set scaled = scaled / 4.0
    set scale = scale * 2.0
  }
  while scaled < 1.0 {
    set scaled = scaled * 4.0
    set scale = scale / 2.0
  }

  float guess = 1.5
  int iteration = 0
  while iteration < 8 {
    set guess = (guess + scaled / guess) / 2.0
    set iteration = iteration + 1
  }
  return guess * scale
}

fn floor(value: float) -> float {
  float whole = float(int(value))
  if value < whole {
    return whole - 1.0
  }
  return whole
}

fn ceil(value: float) -> float {
  float whole = float(int(value))
  if value > whole {
    return whole + 1.0
  }
  return whole
}

fn round(value: float) -> float {
  if value < 0.0 {
    return 0.0 - floor(0.0 - value + 0.5)
  }
  return floor(value + 0.5)
}

fn clamp(value: float, lower: float, upper: float) -> float {
  float minimum = lower
  float maximum = upper
  if minimum > maximum {
    set minimum = upper
    set maximum = lower
  }
  if value < minimum {
    return minimum
  }
  if value > maximum {
    return maximum
  }
  return value
}

fn lerp(a: float, b: float, amount: float) -> float {
  return a + (b - a) * amount
}

fn map_range(value: float, input_min: float, input_max: float, output_min: float, output_max: float) -> float {
  if input_min == input_max {
    return output_min
  }
  return lerp(output_min, output_max, (value - input_min) / (input_max - input_min))
}

fn distance(x1: float, y1: float, x2: float, y2: float) -> float {
  float dx = x2 - x1
  float dy = y2 - y1
  return sqrt(dx * dx + dy * dy)
}

fn approach(current: float, target: float, max_delta: float) -> float {
  float change = abs(max_delta)
  if current < target {
    return min(current + change, target)
  }
  if current > target {
    return max(current - change, target)
  }
  return target
}

fn smoothstep(edge0: float, edge1: float, value: float) -> float {
  if edge0 == edge1 {
    if value < edge0 {
      return 0.0
    }
    return 1.0
  }
  float t = clamp((value - edge0) / (edge1 - edge0), 0.0, 1.0)
  return t * t * (3.0 - 2.0 * t)
}

fn smootherstep(edge0: float, edge1: float, value: float) -> float {
  if edge0 == edge1 {
    if value < edge0 {
      return 0.0
    }
    return 1.0
  }
  float t = clamp((value - edge0) / (edge1 - edge0), 0.0, 1.0)
  return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
}

fn ease_in_quad(amount: float) -> float {
  float t = clamp(amount, 0.0, 1.0)
  return t * t
}

fn ease_out_quad(amount: float) -> float {
  float t = clamp(amount, 0.0, 1.0)
  return t * (2.0 - t)
}

fn ease_in_out_quad(amount: float) -> float {
  float t = clamp(amount, 0.0, 1.0)
  if t < 0.5 {
    return 2.0 * t * t
  }
  return 0.0 - 1.0 + (4.0 - 2.0 * t) * t
}

fn ease_in_cubic(amount: float) -> float {
  float t = clamp(amount, 0.0, 1.0)
  return t * t * t
}

fn ease_out_cubic(amount: float) -> float {
  float t = clamp(amount, 0.0, 1.0) - 1.0
  return t * t * t + 1.0
}

fn ease_in_out_cubic(amount: float) -> float {
  float t = clamp(amount, 0.0, 1.0)
  if t < 0.5 {
    return 4.0 * t * t * t
  }
  float shifted = 2.0 * t - 2.0
  return 0.5 * shifted * shifted * shifted + 1.0
}

fn sin(angle: float) -> float {
  float x = angle
  if x < 0.0 {
    set x = 0.0 - x
  }
  # Binary subtraction of tau multiples avoids slow one-turn-at-a-time loops.
  float remainder = x
  float chunk = 6.283185307179586
  while chunk <= remainder / 2.0 {
    set chunk = chunk * 2.0
  }
  while chunk >= 6.283185307179586 {
    if remainder >= chunk {
      set remainder = remainder - chunk
    }
    set chunk = chunk / 2.0
  }
  set x = remainder
  if angle < 0.0 {
    set x = 0.0 - x
  }
  if x > 3.141592653589793 {
    set x = x - 6.283185307179586
  }
  if x > 1.5707963267948966 {
    set x = 3.141592653589793 - x
  }
  if x < -1.5707963267948966 {
    set x = -3.141592653589793 - x
  }

  float x2 = x * x
  float x3 = x * x2
  float x5 = x3 * x2
  float x7 = x5 * x2
  float x9 = x7 * x2
  float x11 = x9 * x2
  float x13 = x11 * x2
  float x15 = x13 * x2
  return x - x3 / 6.0 + x5 / 120.0 - x7 / 5040.0 + x9 / 362880.0 - x11 / 39916800.0 + x13 / 6227020800.0 - x15 / 1307674368000.0
}

fn cos(angle: float) -> float {
  return sin(angle + 1.5707963267948966)
}
