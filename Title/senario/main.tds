asset bg heian_hall = "asset/bg/heian-banquet.png"

character goi {
  name = "五位"
  pose normal = "asset/char/goi.png"
}

character toshihito {
  name = "利仁"
  pose normal = "asset/char/toshihito.png"
}

scene main {
  bg heian_hall
  show goi.normal left fade 350
  say narrator "平安の都。摂政の邸には、名を呼ばれることのない侍がいた。"
  say narrator "人はただ、その位階で彼を『五位』と呼んだ。"
  say narrator "衣は褪せ、鼻は冬の風に赤い。彼の言葉に耳を貸す者は少ない。"
  say narrator "それでも五位には、誰にも明かさない願いが一つあった。"
  say goi "……芋粥を、いつか心ゆくまで食べてみたい。"
  say narrator "山の芋を甘葛で煮た粥。年に一度、宴の残りをほんの少し口にできるだけ。"
  say narrator "その小さな望みを、五位は長いあいだ胸の奥で温めていた。"
  goto "chapters/banquet.tds"
}
