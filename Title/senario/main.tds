asset bg bedroom = "asset/bg/room.jpg"
asset bg kitchen = "asset/bg/ktichin.png"
asset bg entrance = "asset/bg/home_entrance.jpg"
asset bg street = "asset/bg/near_home.jpg"
asset bg town = "asset/bg/town.jpg"
asset bg school = "asset/bg/school.jpg"
asset bgm morning = "asset/bgm/morning.mp3"
asset bgm going_school = "asset/bgm/going_school.mp3"
asset se cooking = "asset/se/cooking.mp3"
asset se door = "asset/se/open_door.mp3"

character protagonist {
  name = "僕"
}

character sister {
  name = "妹"
  pose normal = "asset/char/sisiter_normal_cutout.png"
  pose dere = "asset/char/sister_dere_cutout.png"
}

character ayaka {
  name = "綾瀬あやか"
  pose normal = "asset/char/ayaka_normal_cutout.png"
  pose dere = "asset/char/ayaka_dere_cutout.png"
}

scene main {
  bg bedroom
  bgm morning
  say narrator "目覚まし時計は、昨晩の命令通りにけたたましく鳴り始めた。"
  say narrator "それを止めるべく、僕は瞼を開ける。"

  clear bg
  bg kitchen
  play se cooking
  show sister.normal left y + 0 fade 250
  say narrator "予定通りに朝食を食べる。"
  say sister "ちょっと、ご飯を食べる前に歯磨きしたの？"
  say protagonist "どっちみち後でするんだから、こっちのほうが効率がいい。"
  show sister.dere left y + 0 fade 180
  say sister "もう……お兄ちゃんは……。"
  say narrator "呆れたような視線を向けてくる妹をよそに、僕は朝食を口へ運ぶ。"

  clear bg
  bg entrance
  say protagonist "すまん。せっかくの入学式のところ悪いが、先に学校へ行っておいてくれないか。"
  say sister "何言ってるの。今日はお兄ちゃんの高校の入学式でしょ？ 私は中等部なんだから、いつもと変わらないし。"
  say protagonist "まぁ、ということで頼んだ。"
  say sister "わ、わかった……。"
  say narrator "妹を先に行かせるのには、もちろん理由がある。"
  say narrator "入学式当日に遅刻する。そんな、いかにも主人公らしいムーブを思いついてしまったのである。"
  say narrator "思いついてしまったものは仕方がない。"
  say sister "じゃあ、行ってくるね。"
  play se door
  say protagonist "行ってらっしゃい。あとで行くから。"
  hide sister fade 180
  say narrator "玄関の扉が閉まる。"
  say narrator "それから十五分ほど経ったところで、僕も家を出た。"
  play se door
  play bgm going_school crossfade 900
  clear bg
  bg town
  say narrator "このくらい遅れて出れば、入学式の途中に教室へ滑り込むことになるだろう。"
  say narrator "むしろ少しくらい目立つほうが、主人公としては都合がいい。"
  say narrator "外へ出ると、朝は案外寒かった。もっとも、十五分早く出たところで寒さは変わらなかっただろう。"
  say narrator "さて。主人公が入学式に遅刻しているとなれば、登校中に何かしらのトラブルへ巻き込まれるのが定石である。"
  say narrator "というわけで、少し遅めに歩くことにした。"
  say narrator "歩幅はそのままに、ピッチだけを落とす。あくまで自然に。イベントを待っている人間だと思われてはいけない。"

  clear bg
  bg street
  say narrator "しばらく歩き、十字路に差しかかった。"
  say narrator "右手の塀の向こうに、見慣れないものが見える。"
  say narrator "明るい色の髪だ。高さからして、おそらく女の子だろう。ハーフなのだろうか。"
  say narrator "その頭は、かなりの速度でこちらへ近づいていた。歩いているというより、走っていると言ったほうが正しそうだ。"
  say narrator "残念ながら、食パンを咥えているかどうかまでは塀に隠れて確認できない。"
  say narrator "しかし、この状況。間違いない。"
  say narrator "そんなことを考えているうちに、僕たちは見事に『曲がり角でぶつかる直前の構図』になっていた。"
  say narrator "止まるべきか。止まらぬべきか。僕はそんな野暮なことは考えない。"
  say narrator "問題は――僕が転ぶか、相手を転ばせるかである。"

  choice "主人公として、どう動く？" {
    "自分が転んで、彼女を受け止める" {
      goto collision_catch
    }
    "身をかわして、相手を転ばせる" {
      goto collision_dodge
    }
  }
}

scene collision_catch {
  say narrator "考える時間は、もうない。僕はとっさに両腕を広げた。"
  show ayaka.normal right y + 0 fade 160
  say narrator "次の瞬間、軽い衝撃。彼女を受け止めた勢いで、僕のほうが道路脇に尻もちをついた。"
  say ayaka "いった……。えっ、だ、大丈夫？ ごめん、前をよく見てなくて！"
  say protagonist "こっちは大丈夫。君こそ怪我はない？"
  goto collision_after
}

scene collision_dodge {
  say narrator "考える時間は、もうない。僕は反射的に横へ飛びのいた。"
  show ayaka.normal right y + 0 fade 160
  say narrator "彼女は僕の鞄をつかみ、勢いを殺しきれないまま、二人そろって道路脇に転がった。"
  say ayaka "いたた……！ ちょっと、避けるなら避けるって言ってよ！"
  say protagonist "言う時間があったら、もう少し格好よく避けてる。君は大丈夫？"
  goto collision_after
}

scene collision_after {
  show ayaka.dere right y + 0 fade 180
  say narrator "彼女は制服についた埃を払い、僕の顔をまじまじと見た。"
  say ayaka "私は平気。……あなた、本当に大丈夫？ 入学式の日に救急車なんて、笑えないよ。"
  say protagonist "それは困る。遅刻して目立つ予定が、欠席で目立つことになる。"
  say ayaka "遅刻する予定？"
  say narrator "しまった。口が滑った。"
  say protagonist "いや、今のは比喩で――。"
  say ayaka "ふうん。わざとゆっくり歩いてたのも、そういうこと？"
  say narrator "この子、見ていたのか。いや、あの速度で走っていたのに？"
  say protagonist "……君も、かなり急いでいるみたいだけど。"
  say ayaka "寝坊したの。目覚ましを止めた記憶はあるんだけど、二度寝したみたい。"
  say protagonist "それは主人公らしい。"
  say ayaka "主人公？"
  say protagonist "いや、なんでもない。"
  say narrator "彼女の髪に、朝の光が差した。近くで見ると、淡い金色に見える。"
  say ayaka "綾瀬あやか。今日からこの学校の一年生。あなたは？"
  say protagonist "僕は――。"
  say narrator "名乗ろうとしたところで、校舎の方から始業を知らせるチャイムが鳴った。"
  say ayaka "入学式、始まっちゃう！ 話は歩きながら。ほら、行くよ！"
  say narrator "彼女は僕の返事を待たずに走り出した。"
  say narrator "遅刻して目立つ計画は、どうやら彼女と一緒に実現するらしい。"

  bg school
  say narrator "校門をくぐると、式場へ向かう新入生の列はもうほとんど途切れていた。"
  say ayaka "あの、さっきは本当にごめんね。あと……助けてくれて、ありがとう。"
  say protagonist "どっちのこと？"
  say ayaka "どっちも。"
  say narrator "あやかは少しだけ笑った。"
  say ayaka "続きは式のあとに聞かせて。遅刻の言い訳も、あなたの名前も。"
  say narrator "こうして僕は、入学式の途中に教室へ滑り込む代わりに、同じく遅刻した少女と式場の扉の前に立つことになった。"
  say narrator "主人公らしい出会いだったかどうかは、まだわからない。"
}
