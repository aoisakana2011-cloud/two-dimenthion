include common.tds

scene main {
  bg rooftop_rain
  show rei.normal left
  say narrator "雨の屋上で、二十面相は仮面を外さなかった。彼女は逃げ道を塞がれているのに、急ぐ様子もない。"
  say rei "明智さんは帰ってこない。あなたなら、誰を信じて探す？"
  say narrator "問いの答えは、事件の手掛かりと、私自身の気持ちに結びついている。"
  choice "明智の行き先を追う相手を選ぶ" {
    "星野澪と、改ざんされた記録を追う" {
      set selected_route = "mio"
      set trust_mio = trust_mio + 2
      goto "routes/mio_01_trace.tds"
    }
    "天宮千早と、消えた作品の来歴を追う" {
      set selected_route = "chihaya"
      set trust_chihaya = trust_chihaya + 2
      goto "routes/chihaya_01_origin.tds"
    }
    "如月怜を追い、彼女の本当の名前を問う" {
      set selected_route = "rei"
      set trust_rei = trust_rei + 2
      goto "routes/rei_01_mask.tds"
    }
    "恋愛ではなく、明智と公的な調査を進める" {
      set selected_route = "common"
      goto "chapters/07_after_choice.tds"
    }
  }
}
