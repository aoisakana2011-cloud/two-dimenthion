scene chapter07_s01 {
  say narrator "第七章・町の祭り・記録 1"
  show sora.normal left fade 100
  show nene.normal right fade 100
  say sora "この記録を、次の世代へ渡したい。"
  say nene "忘れないためには、言葉にすることが大切だね。"
  say narrator "二人は古いノートのページを一枚ずつめくった。"
  set clue = clue + 1
  set affection = affection + 1
  if clue >= 4 {
    say narrator "散らばっていた断片が、ひとつの物語になった。"
  } else {
    say narrator "まだ空白がある。続きを探す必要がある。"
  }
  say sora "次のページに進もう。"
  say nene "うん、最後まで一緒に。"
  wait 50
  goto chapter07_s02
}

