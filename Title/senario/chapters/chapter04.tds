scene chapter04_branch {
  choice "最後の扉を誰と開ける？" {
    "ソラと開ける" {
      set route = "sora"
      goto "routes/sora.tds"
    }
    "ネネと開ける" {
      set route = "nene"
      goto "routes/nene.tds"
    }
    "三人で開ける" {
      set route = "common"
      goto "routes/common.tds"
    }
  }
}

