scene chapter04_s01 {
  say narrator "第四章・最後の鍵・第1節"
  show sora.normal left fade 100
  say sora "この町には、まだ知らない道がある。"
  show nene.normal right fade 100
  say nene "記録を残しておけば、いつか誰かが続きを読めるよ。"
  say narrator "窓から差す光が、古い楽譜の文字を照らした。"
  set clue = clue + 1
  set affection = affection + 1
  if clue >= 2 {
    say narrator "手がかりが増えた。鍵の謎に近づいている。"
  } else {
    say narrator "まだ答えは見えない。二人は歩き続けた。"
  }
  say sora "次は、あの星印を調べよう。"
  say nene "うん。急がなくても、忘れなければ大丈夫。"
  wait 50
  goto chapter04_s02
}

