asset bg lake_biwa = "asset/bg/lake-biwa.png"

scene lake_shore {
  effect fade black 250
  bg lake_biwa
  show goi.normal left
  show toshihito.normal right
  say narrator "翌朝。琵琶湖の岸には冷たい雲が垂れこめていた。"
  say narrator "松の間に、二頭の替え馬と大勢の郎等が待っている。"
  say goi "迎えが……。まさか、あの狐が本当に。"
  say narrator "白髪の郎等が、昨夜の不思議な出来事を語った。"
  say narrator "館の奥方が突然、狐の言葉を伝えたという。"
  say toshihito "どうだ。獣も、わしの使いになる。"
  say goi "驚き入りました。"
  say narrator "五位は頭を下げた。だが、その胸に残ったのは驚きだけではない。"
  say narrator "多くの人を動かせる者と、ただ一杯の粥を夢見る自分。"
  say narrator "二人の隔たりが、湖の広さのように感じられた。"
  say toshihito "もうすぐ着く。今夜はゆっくり休まれよ。"
  say narrator "夕暮れ、馬は敦賀の館へ入った。"
  hide toshihito fade 250
  goto "chapters/feast.tds"
}
