include common.tds as common

scene main {
  bg conservation_lab
  show chihaya.normal right fade 250
  say chihaya "《青い星図》の来歴には、空白があるの。戦後に個人コレクションへ移った記録が、一枚だけ抜けてる。"
  say narrator "千早は修復用の手袋を外し、寄贈台帳の複写を並べた。紙の年代とインクの成分が一致していない。"
  say chihaya "偽物かどうかだけが問題じゃない。誰から誰へ渡ったのか、書かれていないことも作品の一部だから。"
  say narrator "彼女は資料を撮影し、出典と保管場所を記録してから、明智へ共有した。"
  say narrator "台帳の端には、展示室では使われていない顔料の粉が残っていた。"
  set clue = clue + 1
  goto "chapters/03_opening_gallery.tds"
}
