asset bg winter_road = "asset/bg/winter-road.png"

scene winter_journey {
  effect fade black 250
  bg winter_road
  show goi.normal left
  show toshihito.normal right
  say narrator "数日後。二人は冬の都を出た。"
  say narrator "利仁は先を行き、五位は慣れない馬上で手綱を握る。"
  say goi "湯の湧く所とは、粟田口あたりでござろうか。"
  say toshihito "もう少し先だ。"
  say narrator "家並みは途切れ、枯れた田に鴉が降りた。"
  say goi "では、山科でござるな。"
  say toshihito "もう少し。"
  say narrator "山科を越え、三井寺を過ぎても、馬は止まらない。"
  choice "五位は何をする？" {
    "もう一度、行き先を尋ねる" { goto road_question }
    "黙って景色を見つめる" { goto road_silent }
  }
}

scene road_question {
  say goi "利仁殿。これより先は、どちらへ。"
  say toshihito "ようやく訊いたな。越前の敦賀まで行く。"
  goto road_reveal
}

scene road_silent {
  say narrator "白い息が、馬の首の向こうへ流れてゆく。"
  say toshihito "そろそろ言っておこう。行き先は越前の敦賀だ。"
  goto road_reveal
}

scene road_reveal {
  say goi "敦賀……。あの遠い敦賀でござるか。"
  say narrator "湯治のつもりで来た五位は、思わず手綱を引いた。"
  say goi "初めからそうと分かれば、支度もできたものを。"
  say toshihito "わしが一人いれば十分。道中の心配は要らぬ。"
  say narrator "不安は消えない。それでも五位は、馬首を返さなかった。"
  say narrator "芋粥に飽くまで食べる。その約束だけが彼を前へ進ませた。"
  say narrator "夕暮れの野に、一匹の狐が現れた。"
  say toshihito "よい使者がいた。館へ先触れを頼もう。"
  say narrator "利仁は狐を捕え、敦賀の館へ迎えを出すよう言い聞かせた。"
  choice "狐の行方を見ながら、五位は――" {
    "狐を信じてみる" { goto fox_believe }
    "半信半疑のまま進む" { goto fox_doubt }
  }
}

scene fox_believe {
  say goi "あれほど早く走るなら、先に着くやもしれませぬな。"
  say toshihito "そなたも、少しは旅を楽しむ顔になった。"
  say narrator "狐の影は枯れ草の向こうへ消えた。"
  goto "chapters/lake.tds"
}

scene fox_doubt {
  say goi "人の言葉を、獣が運ぶものでござろうか。"
  say toshihito "明日になれば分かる。"
  say narrator "狐の影は枯れ草の向こうへ消えた。"
  goto "chapters/lake.tds"
}
