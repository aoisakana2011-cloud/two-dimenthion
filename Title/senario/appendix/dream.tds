scene appendix_dream_s01 {
  say narrator "資料編・夢の断片・資料1"
  say sora "この記録も、物語の一部なんだね。"
  say nene "未来の誰かが読んでくれるといいな。"
  show sora.normal left fade 100
  show nene.normal right fade 100
  say narrator "古い紙の匂いと、雨の音が静かに残っている。"
  set clue = clue + 1
  set affection = affection + 1
  if clue >= 5 {
    say narrator "散らばった記録が、ひとつの歴史になった。"
  } else {
    say narrator "まだ空白のページが残っている。"
  }
  say narrator "ページを閉じ、次の資料へ進む。"
  wait 50
  goto appendix_dream_s02
}

