include common.tds as common

scene main {
  bg conservation_lab
  show chihaya.normal left
  say narrator "千早は、寄贈台帳の欠けた頁が保管された古い修復記録を見つけた。そこには作品が持ち主へ返された日付がある。"
  say chihaya "名前を伏せることもできる。でも、記録そのものを消したら、返された事実までなかったことになる。"
  say narrator "彼女は公表による危険と、沈黙による損失を並べて考え、関係者へ段階的に連絡した。"
  say chihaya "あなたが一緒に確認してくれるなら、最後まで向き合える気がする。"
  set clue = clue + 1
  goto "routes/chihaya_02_records.tds"
}
